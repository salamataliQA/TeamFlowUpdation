{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      ".firestore-rules-analysis.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/login", "destination": "/login.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/team", "destination": "/team.html" },
      { "source": "/projects", "destination": "/projects.html" },
      { "source": "/assignments", "destination": "/assignments.html" },
      { "source": "/reports", "destination": "/reports.html" },
      { "source": "/extra-hours", "destination": "/extra-hours.html" },
      { "source": "/audit-logs", "destination": "/audit-logs.html" },
      { "source": "/settings", "destination": "/settings.html" }
    ]
  }
}
